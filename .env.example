# Αντίγραψέ το σε .env και συμπλήρωσε τις τιμές.
# Το .env ΔΕΝ ανεβαίνει στο GitHub (.gitignore: .env*).

# Βάση δεδομένων (MySQL)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Κρυπτογράφηση αποθηκευμένων μυστικών (SoftOne, Mailgun) — 32 bytes σε hex
ENCRYPTION_KEY=

# SoftOne ERP
SOFTONE_registeredName=
SOFTONE_company=
SOFTONE_username=
SOFTONE_password=
SOFTONE_appId=
SOFTONE_apiUrl=
SOFTONE_SIMPLE_USER=
SOFTONE_SIMPLE_PASSWORD=

# BunnyCDN (φωτογραφίες αναγνώρισης)
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_BASE_URL=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_CDN_PASSWORD=
BUNNY_CDN_PULLZONE=
BUNNY_CDN_STORAGEZONE=
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=

# Cron
CRON_SECRET=

# Άδεια χρήσης (σελίδα /account/license)
BUYER_NAME=
BUYER_VAT=
BUYER_SERIAL=
BUYER_ACTIVATION_DATE=
SELLER_NAME=
SELLER_VAT=

# Σημείωση: το Mailgun ΔΕΝ ρυθμίζεται εδώ.
# Τα στοιχεία του ζουν στη βάση και αλλάζουν από «Ρυθμίσεις → Mailgun».
#
# Εξαίρεση: το κλειδί υπογραφής των webhooks του Mailgun (Mailgun → Webhooks →
# «HTTP webhook signing key»). Χωρίς αυτό ο receiver `/api/webhooks/mailgun`
# απορρίπτει κάθε συμβάν με 500 — δεν δεχόμαστε ποτέ ανυπόγραφα συμβάντα.
MAILGUN_WEBHOOK_SIGNING_KEY=
